# Same Supabase instance core-service uses — this service reads/writes
# games, rounds, predictions, and token_ledger_entries directly via pgx
# against the schema core-service's Prisma migrations own. Copy the exact
# value from services/core-service/.env.
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
PORT=8080

# Must match core-service's SESSION_COOKIE_NAME (both default to the same
# literal if unset) — this service validates the same session cookie
# core-service issues, never its own.
SESSION_COOKIE_NAME=predictsim_sid

# Same dev/prod CORS policy as core-service's main.ts.
NODE_ENV=development
CORS_ALLOWED_ORIGINS=

# How often (seconds) and how far ahead the round-generation scheduler runs.
ROUND_GENERATOR_INTERVAL_SECONDS=300
ROUND_GENERATOR_DAYS_AHEAD=3
